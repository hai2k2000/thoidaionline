[Unit]
Description=Ensure Thoidai weekly performance evaluation cycle
After=network-online.target thoidai-work.service
Requires=thoidai-work.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/thoidai-work
ExecStart=/usr/bin/node /opt/thoidai-work/scripts/run-weekly-evaluation.mjs
NoNewPrivileges=true
PrivateTmp=true
