[Unit]
Description=Restrict public access to internal app and Supabase ports
After=docker.service network-online.target wg-quick@wg0.service
Wants=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vps-port-guard.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
